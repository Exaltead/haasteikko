    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.5.3",
    "tailwindcss": "4.3.3",
